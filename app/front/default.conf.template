server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACK_URL};
        proxy_set_header Host $host;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
