{
  "uid": "croustino-chart",
  "title": "Croustino Rennes (livré par le chart)",
  "tags": ["croustino"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Commandes par minute",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (produit) (rate(croustino_commandes_total[1m])) * 60",
          "legendFormat": "{{produit}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Taux de rejet",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(croustino_commandes_rejetees_total[5m])) / (sum(rate(croustino_commandes_rejetees_total[5m])) + sum(rate(croustino_commandes_total[5m]))) * 100"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mémoire par pod",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"croustino\", container!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Redémarrages (1 h)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"croustino\"}[1h]))"
        }
      ]
    }
  ]
}
